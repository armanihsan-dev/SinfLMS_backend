# .env.test
NODE_ENV=test
PORT=3901
COOKIE_SECRET=test-secret-key

# Database
DATABASE_URL=postgresql://test_user:test_pass@localhost:5432/test_db
NEON_CLOUD_UEL=postgresql://test_user:test_pass@localhost:5432/test_db

#for docker
NEON_API_KEY=test_api_key
NEON_PROJECT_ID=test_project_id
NEON_BRANCH_ID=test_branch_id

# JWT
JWT_SECRET=test-jwt-secret

# Redis (optional for now)
REDIS_URL=redis://localhost:6379

GOOGLE_CLIENT_ID=test_google_client_id
GOOGLE_CLIENT_SECRET=test_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3901/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:5174

GITHUB_CLIENT_ID=test_github_client_id
GITHUB_CLIENT_SECRET=test_github_client_secret

//Lemon Squeezy
LEMON_SQUEEZY_API_KEY=your_lemon_squeezy_api_key
LEMON_SQUEEZY_STORE_ID=666666
LEMON_SQUEEZY_MONTHLY_VARIANT_ID=7777777
LEMON_SQUEEZY_YEARLY_VARIANT_ID=7777777
LEMON_SQUEEZY_WEBHOOK_SECRET=you_secret


# Nodemailer / Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email
SMTP_PASS=your_app_pass
EMAIL_FROM="your_app_name <your_email>"

# OTP
OTP_EXPIRY_SECONDS=600
OTP_MAX_ATTEMPTS=5